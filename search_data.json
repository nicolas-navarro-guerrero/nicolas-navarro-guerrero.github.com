---
layout: null
---
[
  {% assign all_items = site.pages | concat: site.posts %}
  {% for item in all_items %}
    {% unless item.search_exclude %}
    {
      "title": {% if item.citation and item.citation.title %}{{ item.citation.title | jsonify }}{% else %}{{ item.title | jsonify }}{% endif %},
      "url": "{{ item.url | relative_url }}",
      "tags": {{ item.tags | join: ' ' | jsonify }},
      "categories": {{ item.categories | join: ' ' | jsonify }},
      "content": {{ item.content | strip_html | strip_newlines | normalize_whitespace | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endunless %}
  {% endfor %}
]